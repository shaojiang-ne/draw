# ===== 模型 API 配置（必填）=====
VITE_OPENAI_API_KEY=sk-your-api-key-here

# OpenAI 兼容接口地址，需包含版本前缀（/v1、/v2），末尾不要带斜杠
# 讯飞星火 MaaS: https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
# OpenAI 官方:   https://api.openai.com/v1
# 智谱 GLM:      https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama:   http://localhost:11434/v1
VITE_OPENAI_API_ENDPOINT=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2

# 模型名称，例如 gpt-4o / gpt-4o-mini / GLM-4.6 / spark-4.0-ultra
VITE_OPENAI_MODEL=gpt-4o

# ===== 可选：开发代理目标 =====
# npm run dev 时，前端请求同源 /api，由 Vite 代理转发到上面的接口地址以规避 CORS。
# 默认复用 VITE_OPENAI_API_ENDPOINT；如需代理到另一个地址，可单独指定：
# DEV_PROXY_TARGET=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
